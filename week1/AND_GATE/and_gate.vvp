S_0x1367042d0 .scope module, "and_gate" "and_gate" 2 1;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
o0x128008010 .functor BUFZ 1, C4<z>; HiZ drive
o0x128008040 .functor BUFZ 1, C4<z>; HiZ drive
