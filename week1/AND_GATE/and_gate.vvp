    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x1367148b0_0, 0, 1;
    %delay 100, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x136714800_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1367148b0_0, 0, 1;
    %delay 100, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x136714800_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x1367148b0_0, 0, 1;
    %end;
    .thread T_0;
    .scope S_0x1367044c0;
T_1 ;
    %vpi_call 3 16 "$monitor", $time, " a=%b, b=%b, y=%b", v0x136714800_0, v0x1367148b0_0, v0x136714950_0 {0 0 0};
    %end;
    .thread T_1;
