 .timescale 0 0;
L_0x136714ad0 .functor AND 1, v0x136714800_0, v0x1367148b0_0, C4<1>, C4<1>;
v0x136714800_0 .var "a", 0 0;
v0x1367148b0_0 .var "b", 0 0;
v0x136714950_0 .net "y", 0 0, L_0x136714ad0;  1 drivers
    .scope S_0x1367044c0;
