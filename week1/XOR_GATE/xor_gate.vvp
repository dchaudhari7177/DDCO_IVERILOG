:vpi_module "/opt/homebrew/Cellar/icarus-verilog/12.0/lib/ivl/va_math.vpi";
S_0x1310058c0 .scope module, "xor_gate" "xor_gate" 2 1;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
o0x128030010 .functor BUFZ 1, C4<z>; HiZ drive
o0x128030040 .functor BUFZ 1, C4<z>; HiZ drive
L_0x13101a9b0 .functor XOR 1, o0x128030010, o0x128030040, C4<0>, C4<0>;
v0x131005a30_0 .net "a", 0 0, o0x128030010;  0 drivers
v0x13101a650_0 .net "b", 0 0, o0x128030040;  0 drivers
v0x13101a6f0_0 .net "y", 0 0, L_0x13101a9b0;  1 drivers
S_0x131004bd0 .scope module, "xor_test" "xor_test" 3 1;
 .timescale 0 0;
L_0x13101aaa0 .functor XOR 1, v0x13101a7d0_0, v0x13101a880_0, C4<0>, C4<0>;
v0x13101a7d0_0 .var "a", 0 0;
v0x13101a880_0 .var "b", 0 0;
v0x13101a920_0 .net "y", 0 0, L_0x13101aaa0;  1 drivers
    .scope S_0x131004bd0;
T_0 ;
    %delay 0, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x13101a7d0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x13101a880_0, 0, 1;
    %delay 100, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x13101a7d0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x13101a880_0, 0, 1;
    %delay 100, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x13101a7d0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x13101a880_0, 0, 1;
    %delay 100, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x13101a7d0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x13101a880_0, 0, 1;
    %end;
    .thread T_0;
    .scope S_0x131004bd0;
T_1 ;
    %vpi_call 3 15 "$monitor", $time, " a=%b, b=%b, y=%b", v0x13101a7d0_0, v0x13101a880_0, v0x13101a920_0 {0 0 0};
    %end;
    .thread T_1;
    .scope S_0x131004bd0;
T_2 ;
    %vpi_call 3 18 "$dumpfile", "xor_gate.vcd" {0 0 0};
    %vpi_call 3 19 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x131004bd0 {0 0 0};
    %end;
    .thread T_2;
