:vpi_module "/opt/homebrew/Cellar/icarus-verilog/12.0/lib/ivl/va_math.vpi";
S_0x153e082a0 .scope module, "xnor_gate" "xnor_gate" 2 1;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
o0x158040040 .functor BUFZ 1, C4<z>; HiZ drive
o0x158040070 .functor BUFZ 1, C4<z>; HiZ drive
L_0x153e1d750 .functor XOR 1, o0x158040040, o0x158040070, C4<0>, C4<0>;
L_0x153e1d840 .functor NOT 1, L_0x153e1d750, C4<0>, C4<0>, C4<0>;
v0x153e08410_0 .net *"_ivl_0", 0 0, L_0x153e1d750;  1 drivers
v0x153e1d350_0 .net "a", 0 0, o0x158040040;  0 drivers
v0x153e1d3f0_0 .net "b", 0 0, o0x158040070;  0 drivers
v0x153e1d480_0 .net "y", 0 0, L_0x153e1d840;  1 drivers
S_0x153e07590 .scope module, "xnor_test" "xnor_test" 3 1;
 .timescale 0 0;
L_0x153e1d910 .functor XNOR 1, v0x153e1d570_0, v0x153e1d620_0, C4<0>, C4<0>;
v0x153e1d570_0 .var "a", 0 0;
v0x153e1d620_0 .var "b", 0 0;
v0x153e1d6c0_0 .net "y", 0 0, L_0x153e1d910;  1 drivers
    .scope S_0x153e07590;
T_0 ;
    %delay 0, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x153e1d570_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x153e1d620_0, 0, 1;
    %delay 100, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x153e1d570_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x153e1d620_0, 0, 1;
    %delay 100, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x153e1d570_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x153e1d620_0, 0, 1;
    %delay 100, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x153e1d570_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x153e1d620_0, 0, 1;
    %end;
    .thread T_0;
    .scope S_0x153e07590;
T_1 ;
    %vpi_call 3 17 "$monitor", $time, "a=%b, b=%b, y=%b", v0x153e1d570_0, v0x153e1d620_0, v0x153e1d6c0_0 {0 0 0};
    %end;
    .thread T_1;
    .scope S_0x153e07590;
T_2 ;
    %vpi_call 3 22 "$dumpfile", "xnor_test.vcd" {0 0 0};
    %vpi_call 3 23 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x153e07590 {0 0 0};
    %end;
    .thread T_2;
