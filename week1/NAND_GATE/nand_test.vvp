S_0x11f105370 .scope module, "nand_gate" "nand_gate" 2 1;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
o0x110030040 .functor BUFZ 1, C4<z>; HiZ drive
o0x110030070 .functor BUFZ 1, C4<z>; HiZ drive
L_0x11f11a7d0 .functor AND 1, o0x110030040, o0x110030070, C4<1>, C4<1>;
L_0x11f11a8c0 .functor NOT 1, L_0x11f11a7d0, C4<0>, C4<0>, C4<0>;
v0x11f1054e0_0 .net *"_ivl_0", 0 0, L_0x11f11a7d0;  1 drivers
v0x11f11a3d0_0 .net "a", 0 0, o0x110030040;  0 drivers
v0x11f11a470_0 .net "b", 0 0, o0x110030070;  0 drivers
v0x11f11a500_0 .net "y", 0 0, L_0x11f11a8c0;  1 drivers
S_0x11f104660 .scope module, "nand_test" "nand_test" 3 1;
 .timescale 0 0;
L_0x11f11a990 .functor NAND 1, v0x11f11a5f0_0, v0x11f11a6a0_0, C4<1>, C4<1>;
v0x11f11a5f0_0 .var "a", 0 0;
v0x11f11a6a0_0 .var "b", 0 0;
v0x11f11a740_0 .net "y", 0 0, L_0x11f11a990;  1 drivers
    .scope S_0x11f104660;
T_0 ;
    %delay 0, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x11f11a5f0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x11f11a6a0_0, 0, 1;
    %delay 100, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x11f11a5f0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x11f11a6a0_0, 0, 1;
    %delay 100, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x11f11a5f0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x11f11a6a0_0, 0, 1;
    %delay 100, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x11f11a5f0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x11f11a6a0_0, 0, 1;
    %end;
    .thread T_0;
    .scope S_0x11f104660;
T_1 ;
    %vpi_call 3 15 "$monitor", $time, "a=%b,b=%b,y=%b", v0x11f11a5f0_0, v0x11f11a6a0_0, v0x11f11a740_0 {0 0 0};
    %end;
    .thread T_1;
    .scope S_0x11f104660;
T_2 ;
    %vpi_call 3 19 "$dumpfile", "nand_test.vcd" {0 0 0};
    %vpi_call 3 20 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x11f104660 {0 0 0};
    %end;
    .thread T_2;
