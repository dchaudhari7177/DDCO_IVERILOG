    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x142e1d500_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x142e1d5b0_0, 0, 1;
    %delay 100, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x142e1d500_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x142e1d5b0_0, 0, 1;
    %delay 100, 0;
