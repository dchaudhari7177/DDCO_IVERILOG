v0x142e1d500_0 .var "a", 0 0;
v0x142e1d5b0_0 .var "b", 0 0;
v0x142e1d650_0 .net "y", 0 0, L_0x142e1d8a0;  1 drivers
    .scope S_0x142e07590;
